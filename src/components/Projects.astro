---
---

<section class="space-y-8" id="projects">
  <h3 class="text-xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">Selected Projects</h3>
  
  <div class="space-y-10">
    <!-- Project 1 -->
    <div class="group">
      <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-4 mb-2">
        <h4 class="font-medium text-zinc-900 dark:text-zinc-100 group-hover:underline underline-offset-4 cursor-pointer">
          Fumika Blog Template
        </h4>
        <span class="font-mono text-xs text-zinc-400 dark:text-zinc-500">2026</span>
      </div>
      <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4">
        A clean, minimalist, and modern, static blog template built with Astro. Fumika is heavily modified from Fuwari.
      </p>
      <div class="flex flex-wrap gap-3 font-mono text-xs text-zinc-500 dark:text-zinc-400">
        <span>Astro</span>
        <span>Svelte</span>
        <span>Tailwind CSS</span>
        <span>SCSS</span>
      </div>
    </div>

    <!-- Project 2 -->
    <div class="group">
      <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-4 mb-2">
        <h4 class="font-medium text-zinc-900 dark:text-zinc-100 group-hover:underline underline-offset-4 cursor-pointer">
          Audio State Monitor
        </h4>
        <span class="font-mono text-xs text-zinc-400 dark:text-zinc-500">2026</span>
      </div>
      <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4">
        Terminal-based PopCat state monitor application that tracks microphone threshold levels using the cpal audio library.
      </p>
      <div class="flex flex-wrap gap-3 font-mono text-xs text-zinc-500 dark:text-zinc-400">
        <span>rust</span>
        <span>cpal</span>
        <span>audio-stream</span>
      </div>
    </div>
  </div>
</section>

