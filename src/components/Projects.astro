---
import { getCollection, getEntry, render } from 'astro:content';

const projectCollecion = await getCollection('projects');
const siteData = await getEntry('site', 'config');

if (!siteData) {
  throw new Error('Sita data not found.'); }
const sortedProjects = projectCollecion.sort((a, b) => a.data.order - b.data.order);

const projects = await Promise.all(
  sortedProjects.map(async (project) => {
    const { Content } = await render(project);
    return {
      ...project,
      Content,
    };
  })
);


const { github } = siteData.data;
---

<section class="space-y-8" id="projects">
  <h3 class="title">Selected Projects</h3>
  
  <div class="space-y-10">
    {projects.map(({ data, Content }) => (
      <a
        href={data.url}
        target="_blank"
        rel="noopener noreferrer"
        class="group card"        
      >
        <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-4 mb-2">
          <h4 class="font-medium text-zinc-900 dark:text-zinc-100 inline-flex items-center gap-1">
            <span class="item-title">{data.title}</span>
            <span class="text-xs text-zinc-400 font-normal" aria-hidden="true">↗</span>
          </h4>
          <span class="font-mono text-xs text-zinc-400 dark:text-zinc-500">{data.year}</span>
        </div>
        <div class="text-zinc-600 dark:text-zinc-400 mb-4 markdown"> 
          <Content />
        </div>
        <div class="flex flex-wrap gap-3 font-mono text-xs text-zinc-500 dark:text-zinc-400">
          {data.tech.map((item) => (
            <span>{item}</span>
          ))}
        </div>
      </a>
    ))}

    <div class="pt-6">
      <a 
        href=`${github}?tab=repositories` 
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-2 font-mono text-xs sm:text-sm text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors tracking-widest"
      >
        <span class="uppercase hover-underline">
          View full projects on GitHub
        </span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

