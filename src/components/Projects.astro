---
import { getCollection, render } from 'astro:content';

const projectCollecion = await getCollection('projects');

const sortedProjects = projectCollecion.sort((a, b) => a.data.order - b.data.order);

const projects = await Promise.all(
  sortedProjects.map(async (project) => {
    const { Content } = await render(project);
    return {
      ...project,
      Content,
    };
  })
);
---

<section class="space-y-8" id="projects">
  <h3 class="text-xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">Selected Projects</h3>
  
  <div class="space-y-10">
    {projects.map(({ data, Content }) => (
      <div class="group">
        <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-4 mb-2">
          <h4 class="font-medium text-zinc-900 dark:text-zinc-100 group-hover:underline underline-offset-4 cursor-pointer">
            {data.githubUrl ? (
              <a 
                href={data.githubUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="hover:underline underline-offset-4 inline-flex items-center gap-1"
              >
                {data.title}
                <span class="text-xs text-zinc-400 font-normal">↗</span>
              </a>
            ) : (
              <span>{data.title}</span>
            )}
          </h4>
          <span class="font-mono text-xs text-zinc-400 dark:text-zinc-500">2026</span>
        </div>
        <div class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4"> 
          <Content />
        </div>
        <div class="flex flex-wrap gap-3 font-mono text-xs text-zinc-500 dark:text-zinc-400">
          {data.tech.map((item) => (
            <span>{item}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

