---
import { getEntry } from 'astro:content';

const siteData = await getEntry('site', 'config');

if (!siteData) {
  throw new Error('Sita data not found.');
}

const { name, email, github, linkedin, status } = siteData.data;

const currentYear = new Date().getFullYear();
---

<footer class="pt-12 border-t border-zinc-200 dark:border-zinc-800">
  <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-8">
    
    <div class="space-y-3">
      <div class="flex items-center gap-2">
        <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
        <p class="font-mono text-xs uppercase tracking-widest text-zinc-900 dark:text-zinc-100">
          { status }
        </p>
      </div>
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        © {currentYear} { name }. Built with Astro & Tailwind.
      </p>
    </div>

    <div class="flex flex-col md:text-right gap-2">
      <p class="font-mono text-xs text-zinc-400 dark:text-zinc-500 uppercase tracking-widest mb-1">
        Connect
      </p>
      <div class="flex flex-col gap-1.5 text-sm font-medium">
        <a href=`mailto:${email}` class="text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors inline-flex items-center gap-2">
          Gmail ↗
        </a>
        <a href={linkedin} target="_blank" class="text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors inline-flex items-center gap-2">
          LinkedIn ↗
        </a>
        <a href={github} target="_blank" class="text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors inline-flex items-center gap-2">
          GitHub ↗
        </a>
      </div>
    </div>
    
  </div>
</footer>

