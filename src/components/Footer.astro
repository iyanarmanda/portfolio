---
import { getEntry } from 'astro:content';

const siteData = await getEntry('site', 'config');

if (!siteData) {
  throw new Error('Sita data not found.');
}

const { name, email, github, linkedin, status } = siteData.data;

const currentYear = new Date().getFullYear();
---

<style>
  @reference "../styles/global.css";

  .contact {
    @apply text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors inline-flex items-center gap-2;
  }
</style>

<footer class="pt-12 border-t border-zinc-200 dark:border-zinc-800">
  <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-8">
    
    <div class="space-y-3">
      <div class="flex items-center gap-2">
        <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
        <p class="font-mono text-xs uppercase tracking-widest text-zinc-900 dark:text-zinc-100">
          { status }
        </p>
      </div>
      <span class="text-sm text-zinc-500 dark:text-zinc-400 flex flex-col md:flex-row gap-1 md:gap-2">
        <p>
        © {currentYear} { name }
        </p>
        <span class="hidden md:block text-zinc-200 dark:text-zinc-800">|</span>
        <p>
          Built with Astro & Tailwind.
        </p>
      </span>
    </div>

    <div class="flex flex-col gap-2">
      <p class="font-mono text-xs text-zinc-400 dark:text-zinc-500 uppercase tracking-widest mb-1">
        Connect
      </p>
      <div class="flex flex-col gap-1.5 text-sm font-medium">
        <a href=`mailto:${email}` class="group contact">
          <span class="hover-underline">
            Gmail
          </span>
          <span aria-hidden="true">↗</span>
        </a>
        <a href={linkedin} target="_blank" class="group contact">
          <span class="hover-underline">
            LinkedIn
          </span>
          <span aria-hidden="true">↗</span>
        </a>
        <a href={github} target="_blank" class="group contact">
          <span class="hover-underline">
            GitHub
          </span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    
  </div>
</footer>

