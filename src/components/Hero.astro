---
import { getEntry, render } from 'astro:content';

const siteData = await getEntry('site', 'config');
const heroEntry = await getEntry('hero', 'description');

if (!siteData || !heroEntry) {
  throw new Error(`Data not found. siteData: ${!!siteData}, heroEntry: ${!!heroEntry}`);
}

const { name, role } = siteData.data;
const { Content } = await render(heroEntry);
---

<section class="space-y-6">
  <div class="space-y-2">
    <h1 class="text-3xl md:text-4xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">
      { name }
    </h1>
    <h2 class="text-lg md:text-xl text-zinc-600 dark:text-zinc-400 font-medium">
      { role }
    </h2>
  </div>

  <div class="max-w-2xl text-base md:text-lg leading-relaxed text-zinc-600 dark:text-zinc-400 
              [&_strong]:font-medium [&_strong]:text-zinc-900 dark:[&_strong]:text-zinc-200">
    <Content />
  </div>

</section>

