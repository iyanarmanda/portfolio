  <div class="space-y-12">
    <!-- Item 1 -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 md:gap-8">
      <div class="font-mono text-sm text-zinc-500 mt-1 tracking-widest uppercase">
        2024 — Present
      </div>
      <div class="md:col-span-3 space-y-4">
        <div>
          <h4 class="font-medium text-zinc-900 dark:text-zinc-100">Backend Developer</h4>
