---
import { getCollection, getEntry, render } from 'astro:content';

const experienceCollecion = await getCollection('experience');

const sortedExperience = experienceCollecion.sort((a, b) => a.data.order - b.data.order);

const experience = await Promise.all(
  sortedExperience.map(async (exp) => {
    const { Content } = await render(exp);
    return {
      ...exp,
      Content,
    };
  })
);
---

<section class="space-y-8" id="experience">
  <h3 class="title">Experience</h3>
  
  <div class="space-y-12">
    {experience.map(({ data, Content }) => (
      <div class="grid grid-cols-1 md:grid-cols-4 gap-2 md:gap-8">
        <div class="font-mono text-xs md:text-sm text-zinc-400 dark:text-zinc-500 mt-1 tracking-widest uppercase">
          {data.startDate} — {data.endDate}
        </div>

        <div class="md:col-span-3 space-y-3">
          <div>
            <h4 class="font-medium text-zinc-900 dark:text-zinc-100">
              {data.role}
            </h4>
            <p class="text-sm text-zinc-500 dark:text-zinc-400">
              {data.company}
            </p>
          </div>

          <div class="markdown text-zinc-600 dark:text-zinc-400 text-sm md:text-base">
            <Content />
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

