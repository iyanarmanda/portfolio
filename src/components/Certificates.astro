---
import { getCollection } from 'astro:content';

const certificatesCollection = await getCollection('certificates');
---

<section id="certificates" class="space-y-6">
  <h3 class="text-xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">Certificates</h3>
  
  <ul class="space-y-3">
    {certificatesCollection.map((cert) => (
      <li>
        <button 
          data-image-url={cert.data.img}
          class="modal-trigger w-full group flex items-center justify-between py-2 text-left hover:bg-zinc-100 dark:hover:bg-zinc-800/50 rounded-md transition-colors -mx-2 px-2"
        >
          <div>
            <h4 class="font-medium text-zinc-900 dark:text-zinc-100 group-hover:underline underline-offset-4">{cert.data.title}</h4>
            <p class="text-sm text-zinc-500">{cert.data.issuer}</p>
          </div>
          <span class="font-mono text-xs text-zinc-400">{cert.data.year} ↗</span>
        </button>
      </li>
    ))}
  </ul>
</section>

<script>
  const triggers = document.querySelectorAll('.modal-trigger');

  triggers.forEach(button => {
    button.addEventListener('click', () => {
      const url = button.getAttribute('data-image-url');
      
      window.dispatchEvent(new CustomEvent('open-image-modal', {
        detail: { url }
      }));
    });
  });
</script>

