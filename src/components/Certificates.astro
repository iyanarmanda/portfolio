---
import { getCollection } from 'astro:content';

import CheckBadgeIcon from './icons/CheckBadgeIcon.astro';

const certificatesCollection = await getCollection('certificates');
---

<section id="certificates" class="space-y-6">
  <h3 class="title">Certificates</h3>
  
  <ul class="space-y-3">
    {certificatesCollection.map((cert) => (
      <li>
        <button 
          data-image-url={cert.data.img}
          class="modal-trigger w-full group flex items-center justify-between text-left card"
        >
          <div>
            <h4 class="font-medium text-zinc-900 dark:text-zinc-100">
              <span class="item-title">
                {cert.data.title}
              </span>
              <span class="inline-flex items-center ml-1">
                <CheckBadgeIcon class="w-3.5 h-3.5" />
              </span>
            </h4>
            <p class="text-sm text-zinc-500">{cert.data.issuer}</p>
          </div>
          <span class="font-mono text-xs text-zinc-400">{cert.data.year}</span>
        </button>
      </li>
    ))}
  </ul>
</section>

<script>
  const triggers = document.querySelectorAll('.modal-trigger');

  triggers.forEach(button => {
    button.addEventListener('click', () => {
      const url = button.getAttribute('data-image-url');
      
      window.dispatchEvent(new CustomEvent('open-image-modal', {
        detail: { url }
      }));
    });
  });
</script>

