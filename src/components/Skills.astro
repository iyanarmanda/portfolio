---
import { getCollection } from 'astro:content';

const skillsCollection = await getCollection('skills');
---

<section class="space-y-6">
  <h3 class="title">Skills</h3>
  
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6"> 
    {skillsCollection.map((skillGroup) => (
      <div class="space-y-1.5">
        <h4 class="font-mono text-sm text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">
          { skillGroup.data.category }
        </h4>
        <p class="text-zinc-700 dark:text-zinc-300">
          { skillGroup.data.items.join(', ') }
        </p>
      </div>
    ))} 
  </div>
</section>

