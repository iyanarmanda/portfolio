---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Page Not Found">
  <section class="flex flex-col items-start justify-center min-h-[60vh] space-y-6">
    
    <div class="space-y-2">
      <h1 class="text-5xl md:text-6xl font-mono font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
        404
      </h1>
      <h2 class="text-lg md:text-xl text-zinc-600 dark:text-zinc-400 font-medium">
        Page not found.
      </h2>
    </div>

    <div class="pt-4">
      <a 
        href="/" 
        class="group inline-flex items-center gap-2 font-mono text-sm text-zinc-900 dark:text-zinc-100 hover:text-zinc-600 dark:hover:text-zinc-400 transition-colors tracking-widest"
      >
        <span class="">←</span>
        <span class="uppercase hover-underline">Back</span>
      </a>
    </div>

  </section>
</Layout>

